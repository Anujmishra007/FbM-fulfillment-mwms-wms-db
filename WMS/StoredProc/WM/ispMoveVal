/******************************************************************************/
/* Stored Procedure : ispMoveVal                                              */
/* Copyright        : Maersk                                                  */
/*                                                                            */
/* Purpose          : Extended validation for Inventory Move operations       */
/*                    Validates destination location and LPN before move      */
/* SKE140           : CREATED : 2025-11-15                                    */
/*                                                                            */
/*                                                                            */
/* Date       Rev  Author   Purpose                                           */
/* ---------- ---  -------  ------------------------------------------------- */
/* 2025-11-15 1.0  SKE140   Initial version - Added MaxPallet and ToLoc       */
/*                          validation for JCB during move validation         */
/* 2026-01-14 2.0  Wei Kin  Adding validations on loc flags                   */
/******************************************************************************/

CREATE OR ALTER PROCEDURE [dbo].[ispMoveVal]  
   @c_Lot NVARCHAR(10),  
   @c_FromLoc NVARCHAR(10),  
   @c_FromID NVARCHAR(18),  
   @b_Success INT OUTPUT,  
   @n_Err INT OUTPUT,  
   @c_ErrMsg NVARCHAR(250) OUTPUT  
AS  
BEGIN  
   SET NOCOUNT ON;  
  
   DECLARE @c_ToLoc NVARCHAR(18) = '',  
           @c_ToID  NVARCHAR(18) = '',  
           @c_SourceType NVARCHAR(30) = '',  
           @MaxPallet INT,  
           @CurrentPalletCount INT,  
           @cFacility NVARCHAR(10) = 'EMG03',  
           @cStorerKey NVARCHAR(10) = 'JCB',  
           @cLocCat NVARCHAR(30) = '',  
           @cLocStatus NVARCHAR(10) = '',  
           @cLocFlag NVARCHAR(30) = '',  
           @nLocLevel INT = 0,  
           @cLocBeam NVARCHAR(30) = '',  
           @fIDWeight DECIMAL(18,4) = 0,  
           @fCurrentLocWeight DECIMAL(18,4) = 0,  
           @fCurrentBeamWeight DECIMAL(18,4) = 0,  
           @fMaxLocWeight DECIMAL(18,4) = 999999999,  
           @fMaxBeamWeight DECIMAL(18,4) = 999999999;  
  
   -- Read ToLoc / ToID from the #move temp table  
   SELECT TOP 1  
       @c_ToLoc = ToLoc,  
       @c_ToID  = ToID,  
       @c_SourceType = SourceType  
   FROM #move;  
  
   -- Initialize  
   SET @b_Success = 1;  
   SET @n_Err = 0;  
   SET @c_ErrMsg = '';  
  
   IF ISNULL(@c_ToLoc,'') = ''  
      RETURN;  
  
   --------------------------------------------------------------------  
   -- STEP 2: Check if this validation should apply to this move type  
   --------------------------------------------------------------------  
   IF ISNULL(@c_SourceType, '') LIKE 'rdt%'  
      OR ISNULL(@c_SourceType, '') LIKE 'rdtfnc%'  
   BEGIN  
      SET @b_Success = 1;  
      RETURN;  
   END  
  
   IF ISNULL(@c_SourceType, '') <> 'lsp_Move_Wrapper'  
   BEGIN  
      SET @b_Success = 1;  
      RETURN;  
   END  
  
   --------------------------------------------------------------------  
   -- 1) FLAG VALIDATIONS  
   --------------------------------------------------------------------  
   IF EXISTS (  
      SELECT 1  
      FROM dbo.LOC WITH (NOLOCK)  
      WHERE Loc = @c_ToLoc  
        AND ISNULL(LocationFlag,'') IN ('INACTIVE','HOLD','DAMAGED','DAMAGE','INLOCKED')  
   )  
   BEGIN  
      SET @b_Success = 0;  
      SET @n_Err = 70001;  
      SET @c_ErrMsg = 'Move blocked: Location ' + @c_ToLoc + ' Flag is INACTIVE/HOLD/DAMAGE';  
      RETURN;  
   END  
  
   --------------------------------------------------------------------  
   -- 2.1) STATUS VALIDATION (FROM LOC)  
   --------------------------------------------------------------------  
   IF EXISTS (  
      SELECT 1  
      FROM dbo.LOC WITH (NOLOCK)  
      WHERE Loc = @c_FromLoc  
        AND ISNULL(LocationFlag,'') = 'HOLD'  
   )  
   BEGIN  
      SET @b_Success = 0;  
      SET @n_Err = 70001;  
      SET @c_ErrMsg = 'Move blocked: Location ' + @c_FromLoc + ' Flag is INACTIVE/HOLD.';  
      RETURN;  
   END  
  
   --------------------------------------------------------------------  
   -- 2.2) STATUS VALIDATION (TO LOC)  
   --------------------------------------------------------------------  
   IF EXISTS (  
      SELECT 1  
      FROM dbo.LOC WITH (NOLOCK)  
      WHERE Loc = @c_ToLoc  
        AND ISNULL(Status,'') = 'HOLD'  
   )  
   BEGIN  
      SET @b_Success = 0;  
      SET @n_Err = 70002;  
      SET @c_ErrMsg = 'Move blocked: Location ' + @c_ToLoc + ' Status is HOLD.';  
      RETURN;  
   END  
  
   --------------------------------------------------------------------  
   -- 4) NEW RULE — MAX PALLET CAPACITY  
   --------------------------------------------------------------------  
   IF @c_FromLoc <> @c_ToLoc  
   BEGIN  
      SELECT @MaxPallet = MaxPallet  
      FROM dbo.LOC WITH (NOLOCK)  
      WHERE Loc = @c_ToLoc;  
  
      IF ISNULL(@MaxPallet,0) > 0  
      BEGIN  
         SELECT @CurrentPalletCount = COUNT(*)  
         FROM dbo.LOTxLOCxID WITH (NOLOCK)  
         WHERE Loc = @c_ToLoc  
           AND ID <> ISNULL(@c_ToID,'')  
           AND ID <> ''  
           AND Qty > 0;  
  
         IF ISNULL(@CurrentPalletCount,0) >= @MaxPallet  
         BEGIN  
            SET @b_Success = 0;  
            SET @n_Err = 70005;  
            SET @c_ErrMsg =  
               'Move blocked: Location ' + @c_ToLoc +  
               ' has reached maximum pallet capacity (' + CAST(@MaxPallet AS NVARCHAR(10)) + ').';  
            RETURN;  
         END  
      END  
   END  
  
   --------------------------------------------------------------------  
   -- 5) NEW RULE — Task exists for moved ID  
   --------------------------------------------------------------------  
   IF ISNULL(@c_FromID,'') <> ''  
   BEGIN  
      IF EXISTS (  
         SELECT 1  
         FROM dbo.TaskDetail WITH(NOLOCK) 
         WHERE FromID = ISNULL(@c_FromID,'')  
           AND Status IN ('0','3')  
      )  
      BEGIN  
         SET @b_Success = 0;  
         SET @n_Err = 70004;  
         SET @c_ErrMsg = 'Move blocked: LPN ' + @c_FromID + ' exists in active TASK.';  
         RETURN;  
      END  
   END  
  
   --------------------------------------------------------------------  
   -- 6) NEW RULE — Block overweight pallets from racking locations  
   --------------------------------------------------------------------  
   IF ISNULL(@c_FromID,'') <> '' AND ISNULL(@c_ToLoc,'') <> ''  
   BEGIN  
      SELECT @cLocCat = LocationCategory,  
             @cLocStatus = Status,  
             @cLocFlag = LocationFlag  
      FROM dbo.LOC WITH (NOLOCK)  
      WHERE LOC = @c_ToLoc  
        AND Facility = @cFacility;  
  
      SELECT TOP 1  
             @nLocLevel = ISNULL(LocLevel,0),  
             @cLocBeam = ISNULL(LocationRoom,'')  
      FROM dbo.LOC WITH (NOLOCK)  
      WHERE LOC = @c_ToLoc  
        AND Facility = @cFacility;  
  
      SELECT @fIDWeight = ISNULL(SUM(LLI.Qty * ISNULL(S.STDGROSSWGT,0)),0)  
      FROM dbo.LOTxLOCxID LLI WITH (NOLOCK)  
      INNER JOIN dbo.SKU S WITH (NOLOCK)  
              ON S.Sku = LLI.Sku  
             AND S.StorerKey = LLI.StorerKey  
      WHERE LLI.StorerKey = @cStorerKey  
        AND LLI.ID = @c_FromID  
        AND LLI.Qty > 0;  
  
      SELECT @fCurrentLocWeight = ISNULL(SUM(LLI.Qty * ISNULL(S.STDGROSSWGT,0)),0)  
      FROM dbo.LOTxLOCxID LLI WITH (NOLOCK)  
      INNER JOIN dbo.SKU S WITH (NOLOCK)  
              ON S.Sku = LLI.Sku  
             AND S.StorerKey = LLI.StorerKey  
      WHERE LLI.StorerKey = @cStorerKey  
        AND LLI.LOC = @c_ToLoc  
        AND LLI.Qty > 0;  
  
      SELECT @fCurrentBeamWeight = ISNULL(SUM(LLI.Qty * ISNULL(S.STDGROSSWGT,0)),0)  
      FROM dbo.LOTxLOCxID LLI WITH (NOLOCK)  
      INNER JOIN dbo.SKU S WITH (NOLOCK)  
              ON S.Sku = LLI.Sku  
             AND S.StorerKey = LLI.StorerKey  
      WHERE LLI.StorerKey = @cStorerKey  
        AND LLI.LOC IN (  
            SELECT LOC  
            FROM dbo.LOC L WITH (NOLOCK)  
            WHERE L.LocationRoom = @cLocBeam  
              AND @cLocBeam <> ''  
        )  
        AND LLI.Qty > 0;  
  
      SELECT TOP 1  
             @fMaxLocWeight  = ISNULL(UDF04, 999999999),  
             @fMaxBeamWeight = ISNULL(UDF05, 999999999)  
      FROM dbo.CODELKUP WITH (NOLOCK)  
      WHERE LISTNAME = 'JCBLOCCAP'  
        AND StorerKey = @cStorerKey  
        AND [Long] = @nLocLevel  
        AND [Short] = @cLocCat;  
  
      IF (@fIDWeight > 1000 AND ISNULL(@cLocCat,'') LIKE 'RACK%')  
         OR @fMaxLocWeight - @fCurrentLocWeight - @fIDWeight < 0  
         OR @fMaxBeamWeight - @fCurrentBeamWeight - @fIDWeight < 0  
      BEGIN  
         SET @b_Success = 0;  
         SET @n_Err = 218248;  
         SET @c_ErrMsg = 'Move blocked: overweight pallet cannot be placed in the rack.';  
         RETURN;  
      END  
   END  
   --------------------------------------------------------------------  
   -- 7)  NEW RULE — Block Direct Move for Qtyavailable and Qtypicked
   --------------------------------------------------------------------  
   
   IF ISNULL(@c_FromID,'') <> '' AND ISNULL(@c_FromLoc,'') <> ''
   BEGIN
    IF EXISTS (
        SELECT 1
        FROM dbo.LOTXLOCXID WITH (NOLOCK)
        WHERE LOC = @c_FromLoc
            AND ID = @c_FromID
            AND LOT = 
            CASE
                WHEN @c_Lot IS NULL OR LTRIM(RTRIM(@c_Lot)) = '' 
                     THEN LOT
                ELSE @c_Lot
            END

            AND (
                QTYALLOCATED > 0
                OR QTYPICKED > 0
                )
            AND STORERKEY = 'JCB'
        )
        BEGIN  
         SET @b_Success = 0;  
         SET @n_Err = 70005;  
         SET @c_ErrMsg = 'Move blocked: QTYALLOCATED OR QTYPICKED FOUND!';  
         RETURN;  
      END  
    END

   --------------------------------------------------------------------  
   -- If all validation passed  
   --------------------------------------------------------------------  
   SET @b_Success = 1;  
END
GO

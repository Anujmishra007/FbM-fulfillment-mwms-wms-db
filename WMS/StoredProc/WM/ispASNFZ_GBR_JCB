/* Date        Author   Ver   Purposes                                     */
/* 2025-08-11  SKE140   1.0   Customized the XDCock for JCB                */
/* 2025-08-21  PPA374   1.1   Updating pallet ID for the inventory         */
/*								 at finalisation                                   */
/* 2025-09-11  PPA374   1.2   Changing order creation logic to create new  */
/*                               every time ASN is finalised               */
/***************************************************************************/

CREATE   PROC [dbo].[ispASNFZ_GBR_JCB]
(
   @c_ReceiptKey         NVARCHAR(10),
   @b_Success            INT           OUTPUT,
   @n_Err                INT           OUTPUT,
   @c_ErrMsg             NVARCHAR(255) OUTPUT,
   @c_ReceiptLineNumber  NVARCHAR(5) = ''
)
AS
BEGIN
   SET NOCOUNT ON;

   DECLARE 
      @b_Debug               INT           = 0,
      @n_Continue            INT           = 1,
      @n_StartTranCount      INT           = @@TRANCOUNT,
      @c_ASNStatus           NVARCHAR(10)  = '0',
      @c_DocType             NVARCHAR(1)   = '',
      @c_OrderKey            NVARCHAR(10)  = '',
      @c_StorerKey           NVARCHAR(15)  = '',
      @c_Facility            NVARCHAR(10)  = '',
      @c_ExternOrderKey      NVARCHAR(100) = '',  -- combined key: ExternReceiptKey + '_' + Lottable03
      @c_RecType             NVARCHAR(10)  = '',
      @c_OrderLineNumber     NVARCHAR(5)   = '',
      @c_ExternLineNo        NVARCHAR(20)  = '',
      @c_Sku                 NVARCHAR(20)  = '',
      @c_Packkey             NVARCHAR(10)  = '',
      @c_UOM                 NVARCHAR(10)  = '',
      @n_OriginalQty         INT           = 0,
      @n_OpenQty             INT           = 0,
      @c_Lottable02          NVARCHAR(18)  = '',
      @c_Lottable03          NVARCHAR(18)  = '',
      @c_Lottable08          NVARCHAR(30)  = '',
      @c_Lottable09          NVARCHAR(30)  = '',
      @c_TariffKey           NVARCHAR(10)  = '',
      @c_POKey               NVARCHAR(10)  = '',
      @c_POLineNumber        NVARCHAR(10)  = '',
      @c_ExternReceiptKey    NVARCHAR(50)  = '',
      @c_ConsigneeKey        NVARCHAR(15)  = '',
      @c_DeliveryDate        DATE          = NULL,
      @c_Door                NVARCHAR(10)  = '',
      @c_ExternPOKey         NVARCHAR(20)  = '',
      @c_Id                  NVARCHAR(36)  = '',
      @c_ExistingOrderKey    NVARCHAR(10)  = '',
      @c_ExistingOrderStatus NVARCHAR(10)  = '';
	  
   SET @b_Success = 1;
   SET @n_Err     = 0;
   SET @c_ErrMsg  = N'';

   -- Sync pallet type (as in your original)
   --ispASNFZ_GBR_JCB replaced
   /*--PPA374*/
   UPDATE dbo.ID
   SET ID.PalletType = RD.PalletType
   FROM dbo.ID WITH(NOLOCK)
      INNER JOIN dbo.RECEIPTDETAIL RD WITH(NOLOCK)
         ON ID.Id = RD.ToId
   WHERE ReceiptKey = @c_ReceiptKey
      AND ToID <> ''
   /*--PPA374*/
	   
   -- Load receipt header
   SELECT 
      @c_StorerKey  = R.StorerKey,
      @c_Facility   = R.Facility,
      @c_DocType    = R.DocType,
      @c_ASNStatus  = R.ASNStatus,
      @c_RecType    = R.RECType
   FROM dbo.RECEIPT R WITH(NOLOCK)
   WHERE R.ReceiptKey = @c_ReceiptKey;

   -- Basic guards
   IF @c_StorerKey = '' OR @c_StorerKey IS NULL
   BEGIN
      SET @b_Success = 0; 
	  SET @n_Err = 50001; 
	  SET @c_ErrMsg = N'Invalid ReceiptKey.';
      RETURN;
   END;

   -- If line-level call and ASN not finalized, exit
   IF @c_ReceiptLineNumber <> '' AND @c_ASNStatus <> '9'
      GOTO QUIT_SP;

   -- Require XDOC SKU presence
   IF NOT EXISTS (
      SELECT 1 
	  FROM dbo.RECEIPTDETAIL WITH(NOLOCK) 
	  WHERE ReceiptKey = @c_ReceiptKey 
	     AND SKU LIKE 'XD%'
   )
      GOTO QUIT_SP;

   -- Temp tables
   IF OBJECT_ID('tempdb..#TMP_ORD') IS NOT NULL DROP TABLE #TMP_ORD;
   IF OBJECT_ID('tempdb..#TMP_ORDDTL') IS NOT NULL DROP TABLE #TMP_ORDDTL;

   CREATE TABLE #TMP_ORD
   (
      RowID              INT IDENTITY(1,1) PRIMARY KEY,
      OrderKey           NVARCHAR(10)  NOT NULL DEFAULT(''),
      ReceiptKey         NVARCHAR(10)  NOT NULL DEFAULT(''),
      StorerKey          NVARCHAR(15)  NULL,
      ExternOrderKey     NVARCHAR(100) NOT NULL DEFAULT(''), -- combined
      OrderDate          DATETIME      NULL  DEFAULT(GETDATE()),
      DeliveryDate       DATE          NULL,
      [Priority]         NVARCHAR(10)  NULL  DEFAULT('5'),
      ConsigneeKey       NVARCHAR(15)  NULL  DEFAULT(''),
      Facility           NVARCHAR(5)   NULL,
      BillToKey          NVARCHAR(15)  NOT NULL DEFAULT(''),
      Door               NVARCHAR(10)  NULL  DEFAULT('99'),
      Route              NVARCHAR(10)  NULL  DEFAULT('99'),
      [Status]           NVARCHAR(10)  NULL  DEFAULT('0'),
      Type               NVARCHAR(10)  NOT NULL DEFAULT('0'),
      OrderGroup         NVARCHAR(20)  NULL  DEFAULT('XDOCK'),
      ExternPOKey        NVARCHAR(20)  NULL  DEFAULT(''),
      -- plus a few key address/user fields retained from original
      C_Contact1         NVARCHAR(30)  NULL,
      B_Contact1         NVARCHAR(30)  NULL,
      B_Company          NVARCHAR(45)  NULL,
      C_Address1         NVARCHAR(45)  NULL,
      UserDefine01       NVARCHAR(20)  NULL,
      UserDefine02       NVARCHAR(20)  NULL,
      UserDefine06       DATETIME      NULL,
      UserDefine07       DATETIME      NULL
   );

   CREATE TABLE #TMP_ORDDTL
   (
      OrderKey        NVARCHAR(10)  NOT NULL DEFAULT(''),
      ReceiptKey      NVARCHAR(10)  NOT NULL,
      POKey           NVARCHAR(10)  NULL,
      POLineNumber    NVARCHAR(10)  NULL,
      ExternOrderKey  NVARCHAR(100) NULL, -- combined
      ExternLineNo    NVARCHAR(20)  NULL,
      StorerKey       NVARCHAR(15)  NULL,
      Sku             NVARCHAR(20)  NULL,
      PackKey         NVARCHAR(10)  NULL,
      UOM             NVARCHAR(10)  NULL,
      OriginalQty     INT           DEFAULT(0),
      OpenQty         INT           DEFAULT(0),
      Lottable02      NVARCHAR(18)  NULL,
      Lottable03      NVARCHAR(18)  NULL,
      Lottable08      NVARCHAR(30)  NULL,
      Lottable09      NVARCHAR(30)  NULL,
      UserDefine02    NVARCHAR(18)  NULL DEFAULT(''),
      UserDefine06    DATETIME      NULL,
      PutawayLoc      NVARCHAR(10)  NULL DEFAULT(''),
      ExternPOKey     NVARCHAR(20)  NULL DEFAULT(''),
      ID              NVARCHAR(36)  NULL
   );

   -- Build temp headers and details from receipt details
   DECLARE CUR_RECDET CURSOR LOCAL FAST_FORWARD FOR
      SELECT 
         RD.ReceiptKey,
         ISNULL(RD.POKey,'') AS POKey,
         ISNULL(RD.POLineNumber,'') AS POLineNumber,
         RD.ExternReceiptKey,
         RD.ExternLineNo,
         RD.StorerKey,
         RD.Sku,
         RD.PackKey,
         RD.UOM,
         RD.QtyReceived AS OriginalQty,
         RD.QtyReceived AS OpenQty,
         RD.Lottable03,
         RD.Lottable02,
         RD.Lottable08,
         RD.Lottable09,
         ConsigneeKey = ISNULL(RD.Lottable03,''),
         DeliveryDate = CAST(DATEADD(DAY, 1, RH.FinalizeDate) AS DATE),
         Door         = ISNULL(RD.ToLoc,''),
         RD.ExternPOKey,
         RD.ToId
      FROM dbo.RECEIPT RH WITH(NOLOCK)
         INNER JOIN dbo.RECEIPTDETAIL RD WITH(NOLOCK)
		 ON RH.ReceiptKey = RD.ReceiptKey
      WHERE RH.ReceiptKey = @c_ReceiptKey
         AND RD.QtyExpected > 0
		 AND RD.ToId LIKE 'X%'
      ORDER BY 
	     ISNULL(RD.Lottable03,''), 
		 RD.ReceiptLineNumber;

   OPEN CUR_RECDET;
   FETCH NEXT FROM CUR_RECDET INTO
      @c_ReceiptKey, @c_POKey, @c_POLineNumber, @c_ExternReceiptKey, @c_ExternLineNo, @c_StorerKey,
      @c_Sku, @c_Packkey, @c_UOM, @n_OriginalQty, @n_OpenQty, @c_Lottable03, @c_Lottable02, @c_Lottable08, @c_Lottable09,
      @c_ConsigneeKey, @c_DeliveryDate, @c_Door, @c_ExternPOKey, @c_Id;

   WHILE @@FETCH_STATUS = 0 AND @n_Continue IN (1,2)
   BEGIN
      -- Build combined ExternOrderKey (ExternReceiptKey + '_' + Lottable03)
      SET @c_ExternOrderKey = @c_ExternReceiptKey + '_' + ISNULL(@c_Lottable03,'');

      -- Check if header exists in temp for current split+date+door
      IF EXISTS (
         SELECT 1 
		 FROM #TMP_ORD
         WHERE ExternOrderKey = @c_ExternOrderKey
            AND DeliveryDate   = @c_DeliveryDate
            AND Door           = @c_Door
            AND StorerKey      = @c_StorerKey
      )
      BEGIN
         SELECT @c_OrderKey = OrderKey
         FROM #TMP_ORD
         WHERE ExternOrderKey = @c_ExternOrderKey
            AND DeliveryDate   = @c_DeliveryDate
            AND Door           = @c_Door
            AND StorerKey      = @c_StorerKey;
      END
      ELSE
      BEGIN
         /*-- Check existing ORDERS with same grouping
         SET @c_ExistingOrderKey = '';
         SET @c_ExistingOrderStatus = '';

         SELECT TOP (1)
            @c_ExistingOrderKey    = OH.OrderKey,
            @c_ExistingOrderStatus = OH.Status
         FROM dbo.ORDERS OH WITH(NOLOCK)
         WHERE OH.StorerKey      = @c_StorerKey
            AND OH.ExternOrderKey = @c_ExternOrderKey
            AND OH.DeliveryDate   = @c_DeliveryDate
            AND OH.Door           = @c_Door;*/

         /*IF ISNULL(@c_ExistingOrderKey,'') <> ''
         BEGIN
            -- Reuse existing order key
            SET @c_OrderKey = @c_ExistingOrderKey;

            -- If open, clear its details to rebuild
            IF @c_ExistingOrderStatus = '0'
            BEGIN
               DELETE FROM dbo.ORDERDETAIL WITH(NOLOCK)
			   WHERE OrderKey = @c_ExistingOrderKey;
            END
            ELSE
            BEGIN
               /*-- Closed order exists => skip this group
               FETCH NEXT FROM CUR_RECDET INTO
                  @c_ReceiptKey, @c_POKey, @c_POLineNumber, @c_ExternReceiptKey, @c_ExternLineNo, @c_StorerKey,
                  @c_Sku, @c_Packkey, @c_UOM, @n_OriginalQty, @n_OpenQty, @c_Lottable03, @c_Lottable02, @c_Lottable08, @c_Lottable09,
                  @c_ConsigneeKey, @c_DeliveryDate, @c_Door, @c_ExternPOKey, @c_Id;
               CONTINUE;*/
			   GOTO GENNEWORD
            END
         END
         ELSE*/
         BEGIN
		    --GENNEWORD:
            -- Generate new OrderKey
            SET @c_OrderKey = '';
            EXEC nspg_GetKey
               @KeyName     = 'ORDER',
               @fieldlength = 10,
               @keystring   = @c_OrderKey OUTPUT,
               @b_Success   = @b_Success OUTPUT,
               @n_Err       = @n_Err OUTPUT,
               @c_ErrMsg    = @c_ErrMsg OUTPUT,
               @n_Batch     = 1;
               
			IF @b_Success = 0
            BEGIN
               SET @n_Continue = 3;
               GOTO QUIT_SP;
            END
         END

         -- Insert header row into temp (only once per group)
         --IF @c_ExistingOrderKey = ''  -- only store to temp if we’re creating or rebuilding
         BEGIN
            INSERT INTO #TMP_ORD
               (
                  OrderKey, ReceiptKey, StorerKey, ExternOrderKey, OrderDate, DeliveryDate,
                  [Priority], ConsigneeKey, Facility, BillToKey, Door, [Status], [Type],
                  OrderGroup, ExternPOKey, C_Contact1, B_Contact1, B_Company, C_Address1,
                  UserDefine01, UserDefine02, UserDefine06, UserDefine07
               )
            SELECT
               @c_OrderKey,
               @c_ReceiptKey,
               RH.StorerKey,
               @c_ExternOrderKey,
               GETDATE(),
               @c_DeliveryDate,
               '5',
               @c_ConsigneeKey,
               RH.Facility,
               RH.SellerCompany,             -- BillTo from original
               @c_Door,
               '0',
               '0',
               'XDOCK',
               @c_ExternReceiptKey,
               RH.SellerCompany,
               RH.CarrierReference,
               RH.SellerName,
               RH.SellerAddress1,
               RH.UserDefine01,
               RH.RecType,
               RH.UserDefine06,
               RH.UserDefine07
            FROM dbo.RECEIPT RH WITH(NOLOCK)
            WHERE RH.ReceiptKey = @c_ReceiptKey;
         END
      END

      -- Insert detail row into temp
      INSERT INTO #TMP_ORDDTL
         (
            OrderKey, ReceiptKey, POKey, POLineNumber, ExternOrderKey, ExternLineNo,
            StorerKey, Sku, PackKey, UOM, OriginalQty, OpenQty, Lottable03, Lottable02,
            Lottable08, Lottable09, UserDefine02, UserDefine06, PutawayLoc, ExternPOKey, ID
         )
      VALUES
         (
            @c_OrderKey, @c_ReceiptKey, @c_POKey, @c_POLineNumber, @c_ExternReceiptKey, @c_ExternLineNo,
            @c_StorerKey, @c_Sku, @c_Packkey, @c_UOM, @n_OriginalQty, @n_OpenQty, @c_Lottable03, @c_Lottable02,
            @c_Lottable08, @c_Lottable09, @c_ConsigneeKey, @c_DeliveryDate, @c_Door, @c_ExternPOKey, @c_Id
         );

      FETCH NEXT FROM CUR_RECDET INTO
         @c_ReceiptKey, @c_POKey, @c_POLineNumber, @c_ExternReceiptKey, @c_ExternLineNo, @c_StorerKey,
         @c_Sku, @c_Packkey, @c_UOM, @n_OriginalQty, @n_OpenQty, @c_Lottable03, @c_Lottable02, @c_Lottable08, @c_Lottable09,
         @c_ConsigneeKey, @c_DeliveryDate, @c_Door, @c_ExternPOKey, @c_Id;
   END

   CLOSE CUR_RECDET;
   DEALLOCATE CUR_RECDET;

   -- If no details, exit
   IF NOT EXISTS (
      SELECT 1 
      FROM #TMP_ORDDTL
   )
   BEGIN
      --SET @n_Continue = 3;
      GOTO QUIT_SP;
   END

   -- Insert Orders (skip if existing order was reused and not staged in temp)
   INSERT INTO ORDERS
      (
         OrderKey, StorerKey, ExternOrderKey, OrderDate, DeliveryDate, Priority,
         ConsigneeKey, C_contact1, B_contact1, B_Company, C_Address1,
         Facility, Status, Type, OrderGroup, Door, ExternPOKey,
         UserDefine01, UserDefine02, UserDefine06, UserDefine07,
         Issued
      )
   SELECT
      O.OrderKey, O.StorerKey, O.ExternOrderKey, ISNULL(O.OrderDate,GETDATE()),
      O.DeliveryDate, ISNULL(O.[Priority],'5'),
      O.ConsigneeKey, O.C_Contact1, O.B_Contact1, O.B_Company, O.C_Address1,
      O.Facility, ISNULL(O.[Status],'0'), ISNULL(O.[Type],'0'), ISNULL(O.OrderGroup,'XDOCK'), O.Door, O.ExternPOKey,
      O.UserDefine01, O.UserDefine02, O.UserDefine06, O.UserDefine07,
      'Y'
   FROM #TMP_ORD O
   WHERE NOT EXISTS (
      SELECT 1 
	  FROM dbo.ORDERS OH WITH(NOLOCK) 
      WHERE OH.OrderKey = O.OrderKey
   );

   IF @@ERROR <> 0
   BEGIN
      SET @n_Continue = 3;
      SET @n_Err = 68010;
      SET @c_ErrMsg = 'NSQL' + CONVERT(NCHAR(5),@n_Err) + ': INSERT INTO ORDERS failed (ispASNFZ_GBR_JCB)';
      GOTO QUIT_SP;
   END

   -- Insert Order Details
   INSERT INTO dbo.ORDERDETAIL
      (
         OrderKey, OrderLineNumber, ExternOrderKey, ExternLineNo, StorerKey, Sku,
         PackKey, UOM, OriginalQty, OpenQty, Lottable02, Lottable08, Lottable09,
         TariffKey, Lottable03, ExternPOKey, ID
      )
   SELECT
      TD.OrderKey,
	  RIGHT('00000' + CONVERT(NVARCHAR(5), ROW_NUMBER() OVER (PARTITION BY TD.OrderKey ORDER BY TD.ExternLineNo, TD.Sku)), 5),
      TD.ExternOrderKey,
      TD.ExternLineNo,
      TD.StorerKey,
      TD.Sku,
      TD.PackKey,
      TD.UOM,
      TD.OriginalQty,
      TD.OpenQty,
      TD.Lottable02,
      TD.Lottable08,
      TD.Lottable09,
      CASE 
	     WHEN TF.TariffKey IS NOT NULL 
		    AND TF.TariffKey <> '' 
		 THEN TF.TariffKey 
		 ELSE ISNULL(S.TariffKey,'') 
      END,
      TD.Lottable03,
      TD.ExternPOKey,
      TD.ID
   FROM #TMP_ORDDTL TD
      INNER JOIN dbo.SKU S WITH(NOLOCK)
	  ON TD.StorerKey = S.StorerKey 
	     AND TD.Sku = S.Sku
      LEFT JOIN dbo.TARIFFxFACILITY TF WITH(NOLOCK)
	  ON TF.Facility = @c_Facility 
	     AND TD.StorerKey = TF.StorerKey 
		 AND TD.Sku = TF.Sku;

   IF @@ERROR <> 0
   BEGIN
      SET @n_Continue = 3;
      SET @n_Err = 68020;
      SET @c_ErrMsg = 'NSQL' + CONVERT(NCHAR(5),@n_Err) + ': INSERT INTO ORDERDETAIL failed (ispASNFZ_GBR_JCB)';
      GOTO QUIT_SP;
   END

   -- Respect delayed crossdock: do not allocate
   IF @c_RecType = 'XDELAY'
      GOTO QUIT_SP;

   -- Optional XDock allocation wrapper (kept commented as in original)
    
   EXEC [dbo].[isp_XDock_Wrapper_JCB]
      @c_ReceiptKey = @c_ReceiptKey,
      @c_Facility = @c_Facility,
      @c_StorerKey = @c_StorerKey,
      @b_Success    = @b_Success OUTPUT,
      @n_Err        = @n_Err     OUTPUT,
      @c_ErrMsg     = @c_ErrMsg  OUTPUT;
	  
   IF @@ERROR <> 0 OR @b_Success = 0
   BEGIN
      SET @n_Continue = 3;
      SET @c_ErrMsg = 'XDOCK ASN Allocation Failed. (ispASNFZ_GBR_JCB). ' + RTRIM(ISNULL(@c_ErrMsg,''));
      GOTO QUIT_SP;
   END
    
   QUIT_SP:
   IF @n_Continue = 3
   BEGIN
      SET @b_Success = 0;
      
	  IF @@TRANCOUNT = 1 
	     AND @@TRANCOUNT > @n_StartTranCount
         ROLLBACK TRAN;
   END
   ELSE
   BEGIN
      SET @b_Success = 1;
   END
   RETURN;
END
GO

CREATE OR ALTER PROC [dbo].[isp_XDock_DirectIDAlloc_JCB]
@c_OrderKey NVARCHAR(10) = '',
@c_LoadKey NVARCHAR(10) = '',
@c_WaveKey NVARCHAR(10) = '',
@b_Success INT OUTPUT,
@n_Err INT OUTPUT,
@c_ErrMsg NVARCHAR(250) OUTPUT,
@b_Debug INT = 0
AS
BEGIN
SET NOCOUNT ON;
SET ANSI_NULLS OFF;
SET QUOTED_IDENTIFIER OFF;
SET CONCAT_NULL_YIELDS_NULL OFF;


DECLARE @n_Continue INT = 1,
        @n_StartTCnt INT = @@TRANCOUNT;

SELECT @b_Success=1, @n_Err=0, @c_ErrMsg='';

-- Worklist of order lines to allocate
IF OBJECT_ID('tempdb..#WorkOD','U') IS NOT NULL DROP TABLE #WorkOD;
CREATE TABLE #WorkOD
(
    RowID            INT IDENTITY(1,1) PRIMARY KEY,
    OrderKey         NVARCHAR(10),
    OrderLineNumber  NVARCHAR(5),
    StorerKey        NVARCHAR(15),
    Sku              NVARCHAR(20),
    Facility         NVARCHAR(5),
    OpenQty          INT,
    PackKey          NVARCHAR(10),
    OD_ID            NVARCHAR(18), -- ORDERDETAIL.ID we will match to LLI.ID
    Lot02            NVARCHAR(18),
    Lot09            NVARCHAR(30)
);

-- Scope orders by one of: OrderKey, LoadKey, WaveKey
IF @c_OrderKey <> ''
BEGIN
    INSERT #WorkOD (OrderKey, OrderLineNumber, StorerKey, Sku, Facility, OpenQty, PackKey, OD_ID, Lot02, Lot09)
    SELECT  o.OrderKey, od.OrderLineNumber, od.StorerKey, od.Sku, o.Facility,
            OpenQty = (od.OpenQty - od.QtyAllocated - od.QtyPicked),
            sku.PackKey,
            OD_ID = od.ID,      -- requires ORDERDETAIL.ID present
            Lot02 = od.Lottable02,
            Lot09 = od.Lottable09
    FROM ORDERS o WITH (NOLOCK)
    JOIN ORDERDETAIL od WITH (NOLOCK) ON od.OrderKey = o.OrderKey
    JOIN SKU WITH (NOLOCK) ON SKU.StorerKey = od.StorerKey AND SKU.Sku = od.Sku
    WHERE o.OrderKey = @c_OrderKey
      AND o.Type = '0'
      AND ISNULL(o.OrderGroup,'') = 'XDOCK'
      AND o.SOStatus <> 'CANC'
      AND o.Status < '9'
      AND (od.OpenQty - od.QtyAllocated - od.QtyPicked) > 0;
END

ELSE
BEGIN
    SET @n_Continue = 3;
    SET @b_Success = 0;
    SET @n_Err = 81000;
    SET @c_ErrMsg = 'No scope specified. Provide OrderKey or LoadKey or WaveKey.';
    GOTO QUIT_SECTION;
END

IF NOT EXISTS(SELECT 1 FROM #WorkOD)
BEGIN
    -- nothing to do
    GOTO QUIT_SECTION_SUCCESS;
END

-- Iterate each order line and allocate strictly from matching ID + lottables
DECLARE @OrderKey NVARCHAR(10),
        @OrderLineNumber NVARCHAR(5),
        @StorerKey NVARCHAR(15),
        @Sku NVARCHAR(20),
        @Facility NVARCHAR(5),
        @OpenQty INT,
        @PackKey NVARCHAR(10),
        @OD_ID NVARCHAR(18),
        @Lot02 NVARCHAR(18),
        @Lot09 NVARCHAR(30);

DECLARE curOD CURSOR LOCAL FAST_FORWARD READ_ONLY FOR
    SELECT OrderKey, OrderLineNumber, StorerKey, Sku, Facility, OpenQty, PackKey, OD_ID, Lot02, Lot09
    FROM #WorkOD
    ORDER BY OrderKey, OrderLineNumber;

OPEN curOD;
FETCH NEXT FROM curOD INTO @OrderKey, @OrderLineNumber, @StorerKey, @Sku, @Facility, @OpenQty, @PackKey, @OD_ID, @Lot02, @Lot09;

WHILE @@FETCH_STATUS = 0 AND @n_Continue IN(1,2)
BEGIN
    IF @b_Debug=1
        PRINT CONCAT('Allocating ', @OrderKey, '/', @OrderLineNumber, ' SKU=', @Sku, ' OpenQty=', @OpenQty, ' ID=', ISNULL(@OD_ID,''), ' Lot02=', ISNULL(@Lot02,''), ' Lot09=', ISNULL(@Lot09,''));

    IF ISNULL(@OD_ID,'') = ''
    BEGIN
        IF @b_Debug=1 PRINT 'Skip: ORDERDETAIL.ID is empty, cannot match ID.';
        GOTO NEXT_OD;
    END

    -- Find the exact inventory ID rows that match:
    --   - Same StorerKey, Sku, Facility
    --   - Exact ID = ORDERDETAIL.ID
    --   - LOT’s attribute Lot02, Lot09 match ORDERDETAIL.Lottable02, Lottable09
    --   - Available > 0
    IF OBJECT_ID('tempdb..#Inv','U') IS NOT NULL DROP TABLE #Inv;
    CREATE TABLE #Inv
    (
        Loc NVARCHAR(10),
        Lot NVARCHAR(10),
        Id  NVARCHAR(18),
        AvailQty INT
    );

    INSERT #Inv (Loc, Lot, Id, AvailQty)
    SELECT  lli.Loc,
            lli.Lot,
            lli.Id,
            AvailQty = (lli.Qty - lli.QtyAllocated - lli.QtyPicked - lli.QtyReplen)
    FROM LOTxLOCxID lli WITH (NOLOCK)
    JOIN LOC lc WITH (NOLOCK) ON lc.Loc = lli.Loc AND lc.Facility = @Facility AND lc.Status='OK'
    JOIN LOT lt WITH (NOLOCK) ON lt.Lot = lli.Lot AND lt.Status='OK'
    JOIN LOTATTRIBUTE la WITH (NOLOCK) ON la.Lot = lt.Lot
    WHERE lli.StorerKey = @StorerKey
      AND lli.Sku = @Sku
      AND lli.Id = @OD_ID
      AND (lli.Qty - lli.QtyAllocated - lli.QtyPicked - lli.QtyReplen) > 0
      AND ISNULL(la.Lottable02,'') = ISNULL(@Lot02,'')
      AND ISNULL(la.Lottable09,'') = ISNULL(@Lot09,'');

    IF NOT EXISTS(SELECT 1 FROM #Inv)
    BEGIN
        IF @b_Debug=1 PRINT 'No matching inventory found for this line.';
        GOTO NEXT_OD;
    END

    DECLARE @QtyLeft INT = @OpenQty;

    DECLARE @iLoc NVARCHAR(10),
            @iLot NVARCHAR(10),
            @iId  NVARCHAR(18),
            @iAvail INT,
            @PickQty INT,
            @PickDetailKey NVARCHAR(10),
            @rc INT;

    DECLARE curInv CURSOR LOCAL FAST_FORWARD READ_ONLY FOR
        SELECT Loc, Lot, Id, AvailQty
        FROM #Inv
        ORDER BY Loc, Lot;  -- deterministic order, minimal logic

    OPEN curInv;
    FETCH NEXT FROM curInv INTO @iLoc, @iLot, @iId, @iAvail;

    WHILE @@FETCH_STATUS = 0 AND @QtyLeft > 0 AND @n_Continue IN(1,2)
    BEGIN
        SET @PickQty = CASE WHEN @iAvail >= @QtyLeft THEN @QtyLeft ELSE @iAvail END;
        IF @PickQty <= 0 GOTO NEXT_INV;

        -- Generate PickDetailKey
        SET @PickDetailKey = '';
        EXEC @rc = nspg_getkey
              @KeyName='PickDetailKey',
              @fieldlength=10,
              @keystring=@PickDetailKey OUTPUT,
              @b_Success=@b_Success OUTPUT,
              @n_err=@n_Err OUTPUT,
              @c_errmsg=@c_ErrMsg OUTPUT;
        IF @b_Success<>1 OR ISNULL(@PickDetailKey,'')=''
        BEGIN
            SET @n_Continue=3;
            IF ISNULL(@c_ErrMsg,'')='' SET @c_ErrMsg='Failed to get PickDetailKey.';
            SET @n_Err = ISNULL(@n_Err,81011);
            CLOSE curInv; DEALLOCATE curInv;
            GOTO QUIT_SECTION;
        END

        BEGIN TRAN;
        INSERT PICKDETAIL WITH (ROWLOCK)
        (
            PickDetailKey, CaseID, PickHeaderKey,
            OrderKey, OrderLineNumber, Lot,
            StorerKey, Sku, AltSku,
            UOM, UOMQty, Qty,
            QtyMoved, [Status], DropID,
            Loc, ID, PackKey,
            UpdateSource, CartonGroup, CartonType,
            ToLoc, DoReplenish, ReplenishZone,
            DoCartonize, PickMethod, WaveKey,
            ShipFlag, PickSlipNo, TaskDetailKey,
            TaskManagerReasonKey, Notes, MoveRefKey,
            TrafficCop
        )
        VALUES
        (
            @PickDetailKey, '', '',
            @OrderKey, @OrderLineNumber, @iLot,
            @StorerKey, @Sku, '',
            '6', 1, @PickQty,          -- UOM=6 EA, 1 per UOMQty for simplicity
            0, '0', @iId,
            @iLoc, @iId, @PackKey,
            '0', 'STD', '',
            '', 'N', '',
            'N', '', '',
            'N', '', '',
            '', '', '',
            'U'
        );

-- Immediately mark as picked (Status='5')
            UPDATE pd WITH (ROWLOCK)
               SET pd.Status = '5',
                   pd.EditDate = GETDATE()
            FROM PICKDETAIL pd
            WHERE pd.PickDetailKey = @PickDetailKey
              --AND pd.Status = '0';

        IF @@ERROR<>0
        BEGIN
            ROLLBACK TRAN;
            SET @n_Continue=3;
            SET @n_Err=81012;
            SET @c_ErrMsg='Insert PICKDETAIL failed.';
            CLOSE curInv; DEALLOCATE curInv;
            GOTO QUIT_SECTION;
        END

        -- Reduce line left
        SET @QtyLeft = @QtyLeft - @PickQty;
        COMMIT TRAN;

        IF @b_Debug=1
            PRINT CONCAT('Allocated/PICKED', @PickQty, ' from ', @iLoc, '/', @iId, ' Lot=', @iLot, ' to ', @OrderKey, '/', @OrderLineNumber);

        NEXT_INV:
        FETCH NEXT FROM curInv INTO @iLoc, @iLot, @iId, @iAvail;
    END

    CLOSE curInv;
    DEALLOCATE curInv;

    NEXT_OD:
    FETCH NEXT FROM curOD INTO @OrderKey, @OrderLineNumber, @StorerKey, @Sku, @Facility, @OpenQty, @PackKey, @OD_ID, @Lot02, @Lot09;
END

CLOSE curOD;
DEALLOCATE curOD;

GOTO QUIT_SECTION_SUCCESS;
QUIT_SECTION:
SET @b_Success = 0;
IF @@TRANCOUNT = 1 AND @@TRANCOUNT > @n_StartTCnt
ROLLBACK TRAN;
ELSE
BEGIN
WHILE @@TRANCOUNT > @n_StartTCnt
COMMIT TRAN;
END
IF ISNULL(@c_ErrMsg,'')='' SET @c_ErrMsg='XDock direct allocator failed.';
RETURN;

QUIT_SECTION_SUCCESS:
SET @b_Success = 1;
WHILE @@TRANCOUNT > @n_StartTCnt
COMMIT TRAN;
RETURN;
END
GO

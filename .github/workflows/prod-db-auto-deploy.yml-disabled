#     if: inputs.PROD-AMERICAS != ''
#     uses: Maersk-Global/Athena-Automations/.github/workflows/Close-change-request.yml@main
#     secrets: inherit
#     needs: [ PROD-Americas-Deployment, Deploy-with-change-americas ]
#     with:
#       change-number: ${{ needs.deploy-with-change-americas.outputs.change-number }}
#       sys-id: ${{ needs.deploy-with-change-americas.outputs.sys-id }}
#       change-dates: ${{ needs.deploy-with-change-americas.outputs.change-dates }}

  Deploy-with-change-asia:
    if: inputs.PROD-ASIA != ''
    uses: Maersk-Global/Athena-Automations/.github/workflows/deploy-with-change.yml@main
    secrets: inherit
    with:
      description: ${{ inputs.description }}
      notify-email: ${{ inputs.notify-email }}
      app-name: ${{ inputs.app-name }}
      change-template: ${{ inputs.template }}

  Close-change-asia:
    if: inputs.PROD-ASIA != ''
    uses: Maersk-Global/Athena-Automations/.github/workflows/Close-change-request.yml@main
    secrets: inherit
    needs: [ deploy-cdt, Deploy-with-change-asia ]
    with:
      change-number: ${{ needs.deploy-with-change-asia.outputs.change-number }}
      sys-id: ${{ needs.deploy-with-change-asia.outputs.sys-id }}
      change-dates: ${{ needs.deploy-with-change-asia.outputs.change-dates }}

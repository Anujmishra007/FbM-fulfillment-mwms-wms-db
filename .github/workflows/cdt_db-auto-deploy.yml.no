name: Deploy to CDT DB on PR Merge

on:
  pull_request:
    types:
      - closed

      
jobs:
  deploy-cdt:
    if: github.event.pull_request.merged == true && github.base_ref == 'main'
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Check for modified .sql files
        id: check_sql
        shell: bash
        run: |
          CHANGED_FILES=$(git diff --name-only ${{ github.event.pull_request.base.sha }} HEAD)

          # Separate files into WMS/Tables/*.sql and other WMS/*.sql
          WMS_TABLES_SQL=$(echo "$CHANGED_FILES" | grep '^WMS/Tables/.*\.sql' || true)
          OTHER_SQL=$(echo "$CHANGED_FILES" | grep '^WMS/.*\.sql' | grep -v '^WMS/Tables/' || true)
          ALL_CHANGED_FILES=""
          # Concatenate files: WMS/Tables/*.sql files first, then the other SQL files
          if [[ -n "$WMS_TABLES_SQL" ]]; then
            ALL_CHANGED_FILES="$WMS_TABLES_SQL"
          fi
          if [[ -n "$OTHER_SQL" ]]; then
            if [[ -n "$ALL_CHANGED_FILES" ]]; then
              ALL_CHANGED_FILES="$ALL_CHANGED_FILES"$'\n'"$OTHER_SQL"
            else
              ALL_CHANGED_FILES="$OTHER_SQL"
            fi
          fi

          if [[ -n "$ALL_CHANGED_FILES" ]]; then
            echo "SQL files modified:"
            echo "$ALL_CHANGED_FILES"
            echo "run_sql=true" >> $GITHUB_ENV
            CHANGED_FILES_CSV=$(echo "$ALL_CHANGED_FILES" | paste -sd "," -)
            echo "changed_files=$CHANGED_FILES_CSV" >> $GITHUB_ENV
          else
            echo "No SQL files modified."
            echo "run_sql=false" >> $GITHUB_ENV
          fi

      - name: Print Modified SQL files
        if: env.run_sql == 'true'
        shell: bash
        run: |
          echo "Executing SQL-related operations..."
          echo "Changed SQL files: $changed_files"
      
      - name: Install dependencies (yq)
        run: |
          sudo apt-get install -y jq

      - name: Issue token
        if: env.run_sql == 'true'
        id: issue-token
        run: |
          response=$(curl -s -X POST -H "Content-Type: application/x-www-form-urlencoded" \
            -d "grant_type=client_credentials&client_id=${{ secrets.SPN_CLIENT_ID }}&client_secret=${{ secrets.SPN_CLIENT_SECRET }}&resource=api://b506118d-67ee-44d4-9bee-61bf30f7866d/" \
            "https://login.microsoftonline.com/05d75c05-fa1a-42e7-9cf1-eb416c396f2d/oauth2/token")
          
          token=$(echo "$response" | jq -r .access_token)
          
          if [[ -z "$token" ]]; then
            echo "Error issuing token"
            exit 1
          fi

          echo "bearer_token=${token}" >> $GITHUB_ENV

      - name: Deploy to CDT DB
        id: deploy_CDT
        if: env.run_sql == 'true'
        run: |
          payload='{
            "region": "westeurope",
            "repositoryName": "fbm-infra-automation",
            "playbookPath": "db-auto-deploy-cdt.yml",
            "inventoryPath": "inventories/cdt.yml",
            "branchName": "main",
            "debugFlag": true,
            "extraVars": {
              "ENV_CODE": "cdt",
              "ENV_TYPE": "cdt",
              "REGION": "westeurope",
              "GEOGRAPHY": "europe",
              "PRODUCT_CODE": "wms",
              "PLATFORM_CODE": "fbm",
              "HASHICORP_VAULT_URL": "https://vault.maersk-digital.net",
              "targets": "wmsdb1",
              "country_list": "ALL",
              "script_files": "${{ env.changed_files}}"
            }
          }'

          echo "Deploying with the following payload: $payload"


          response=$(curl -s -X POST https://bffp.maersk-digital.net/v2/platforms/fbm/environments/cdt/products/wms/configurations \
            -H "Authorization: Bearer $bearer_token" \
            -H "Content-Type: application/json" \
            -d "$payload")

          echo "Response from API: $response"

      - name: Deployment Request Failure Notification
        if: steps.deploy_CDT.outcome == 'failure'
        uses: jdcargile/ms-teams-notification@v1.3
        with:
          github-token: ${{ github.token }}
          ms-teams-webhook-uri: ${{ secrets.MSTEAMS_NOTIFY_WEBHOOK }}
          notification-summary: Deployment Request Failed &#x1F534
          notification-color: D30A13

      - name: Deployment Request Success Notification
        if: steps.deploy_CDT.outcome == 'success'
        uses: jdcargile/ms-teams-notification@v1.3
        with:
          github-token: ${{ github.token }}
          ms-teams-webhook-uri: ${{ secrets.MSTEAMS_NOTIFY_WEBHOOK }}
          notification-summary: Deployment Triggered Successfully &#x2705
          notification-color: 04A10E

      - name: Print Grafana URL
        if: env.run_sql == 'true'
        run: echo "::notice title=Grafana Link::https://grafana.maersk.io/goto/F49pfjONR?orgId=1"

